# ---- Core ----
LITTLEGO_ENVIRONMENT=development          # set to production on the live server
LITTLEGO_DATABASE_URL=sqlite:///./littlego.db
# LITTLEGO_DATABASE_URL=postgresql+psycopg://littlego:littlego@localhost:5432/littlego
LITTLEGO_JWT_SECRET=replace-with-64-random-characters
LITTLEGO_PIN_ENCRYPTION_KEY=              # python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
LITTLEGO_CORS_ORIGINS=*                   # production: https://ops.yourdomain.ng
LITTLEGO_OPS_ALERT_PHONES=+2348000000000  # comma separated; get every critical alert by SMS

# ---- SMS (choose one) ----
LITTLEGO_SMS_PROVIDER=console             # console | termii | africastalking
LITTLEGO_SMS_SENDER_ID=LittleGo           # register this sender ID with your provider first
LITTLEGO_TERMII_API_KEY=
LITTLEGO_TERMII_BASE_URL=https://api.ng.termii.com   # copy the base URL from your Termii dashboard
LITTLEGO_TERMII_CHANNEL=dnd               # ask Termii support to enable DND for transactional SMS
LITTLEGO_AFRICASTALKING_USERNAME=sandbox
LITTLEGO_AFRICASTALKING_API_KEY=

# ---- Payments ----
LITTLEGO_PAYMENT_PROVIDER=mock            # mock | paystack
LITTLEGO_PAYSTACK_SECRET_KEY=             # sk_test_... first, sk_live_... after testing
LITTLEGO_PAYSTACK_CALLBACK_URL=
