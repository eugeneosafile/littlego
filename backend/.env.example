# ---- Core ----
WARDRIDE_ENVIRONMENT=development          # set to production on the live server
WARDRIDE_DATABASE_URL=sqlite:///./wardride.db
# WARDRIDE_DATABASE_URL=postgresql+psycopg://wardride:wardride@localhost:5432/wardride
WARDRIDE_JWT_SECRET=replace-with-64-random-characters
WARDRIDE_PIN_ENCRYPTION_KEY=              # python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
WARDRIDE_CORS_ORIGINS=*                   # production: https://ops.yourdomain.ng
WARDRIDE_OPS_ALERT_PHONES=+2348000000000  # comma separated; get every critical alert by SMS

# ---- SMS (choose one) ----
WARDRIDE_SMS_PROVIDER=console             # console | termii | africastalking
WARDRIDE_SMS_SENDER_ID=WardRide           # register this sender ID with your provider first
WARDRIDE_TERMII_API_KEY=
WARDRIDE_TERMII_BASE_URL=https://api.ng.termii.com   # copy the base URL from your Termii dashboard
WARDRIDE_TERMII_CHANNEL=dnd               # ask Termii support to enable DND for transactional SMS
WARDRIDE_AFRICASTALKING_USERNAME=sandbox
WARDRIDE_AFRICASTALKING_API_KEY=

# ---- Payments ----
WARDRIDE_PAYMENT_PROVIDER=mock            # mock | paystack
WARDRIDE_PAYSTACK_SECRET_KEY=             # sk_test_... first, sk_live_... after testing
WARDRIDE_PAYSTACK_CALLBACK_URL=
