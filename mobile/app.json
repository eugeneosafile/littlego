{
  "expo": {
    "name": "LittleGo",
    "slug": "littlego",
    "version": "0.3.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.littlego.app",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "LittleGo shares the vehicle's location with parents during school trips.",
        "ITSAppUsesNonExemptEncryption": false
      },
      "buildNumber": "3"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#0A1F3F",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.littlego.app",
      "permissions": [
        "ACCESS_FINE_LOCATION",
        "ACCESS_COARSE_LOCATION",
        "CAMERA",
        "android.permission.CAMERA",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION"
      ],
      "config": {
        "googleMaps": {
          "apiKey": "REPLACE_WITH_GOOGLE_MAPS_ANDROID_KEY"
        }
      },
      "versionCode": 3
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "scheme": "littlego",
    "plugins": [
      [
        "expo-camera",
        {
          "cameraPermission": "LittleGo uses the camera to scan children's QR cards when they board.",
          "recordAudioAndroid": false
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "LittleGo shares the vehicle's location with parents during school trips."
        }
      ],
      "expo-secure-store",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "backgroundColor": "#0A1F3F",
          "imageWidth": 220
        }
      ]
    ],
    "description": "LittleGo: safe, child-only rides home from school.",
    "extra": {
      "eas": {
        "projectId": "3e43ca2b-2fac-4ac9-a739-66cf530f9799"
      }
    },
    "owner": "thegenegingers-team"
  }
}
