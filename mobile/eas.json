{
  "cli": {
    "version": ">= 16.0.0",
    "appVersionSource": "local"
  },
  "build": {
    "development": {
      "developmentClient": false,
      "distribution": "internal",
      "env": {
        "EXPO_PUBLIC_API_URL": "http://192.168.1.20:8000"
      }
    },
    "preview": {
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      },
      "env": {
        "EXPO_PUBLIC_API_URL": "https://littlego-api.onrender.com"
      },
      "environment": "preview"
    },
    "production": {
      "env": {
        "EXPO_PUBLIC_API_URL": "https://littlego-api.onrender.com"
      },
      "environment": "production"
    }
  },
  "submit": {
    "production": {}
  }
}
